#!/usr/bin/env Rscript
# ============================================================
# JUGNU_IMMUNOPEPTIDOME — Step 4: filter_and_bedfiles.R
# July 2026 | Gaurav Raichand | The Institute of Cancer Research
#
# Purpose: Filter NetMHCpan + MHCflurry predictions to strong binders
#          (Tier 1: NMP EL rank < 0.5% AND MHCflurry affinity < 500 nM),
#          join back to protein coordinates from Step 1, write bed file.
#
# This combines the filtering logic from 4a (cross-analysis) and the
# bed generation logic from 4_gen_bedfiles, simplified:
#   - No ALT/WT distinction (all peptides are canonical native)
#   - No figures
#   - No sample matrix
#   - Just: filter SB -> join coordinates -> write bed
#
# Input (from config.sh, all in OUTPUT_DIR):
#   NetMHCpan:  canonical_0Xmer_netmhcpan_YYYY_MMDD.tsv  (x4 lengths)
#   MHCflurry:  canonical_0Xmers_flank_mhcflurry_YYYY_MMDD.csv (x4)
#   Coordinates: canonical_0Xmers_YYYYMMDD.tsv  (from Step 1, x4)
#
# Output (in OUTPUT_DIR):
#   canonical_immunopeptidome_SB_YYYYMMDD.bed
#     SOPRANO-compatible columns only: enst | aa_start | aa_end | peptide | allele
#
#   canonical_immunopeptidome_SB_YYYYMMDD.tsv  (same, tab-delimited, with header)
#
# Tier 1 (Strong Binder) criteria -- same as JUGNU pipeline:
#   NetMHCpan EL rank  < 0.5%   (top 0.5th percentile)
#   MHCflurry affinity < 500 nM
#   Both tools must agree
#
# Scale note: ~12M peptides per length x 4 lengths.
#   Processed one length at a time to avoid OOM.
#   Each length is loaded, filtered, freed before the next.
# ============================================================

suppressPackageStartupMessages({
  library(data.table)
})

start_time  <- proc.time()

###########################################################################
# 1. Config
###########################################################################

output_dir <- Sys.getenv("OUTPUT_DIR")
if (output_dir == "") stop("[ERROR] OUTPUT_DIR not set -- source config.sh first.")

# Tier 1 thresholds -- same as JUGNU pipeline
NMP_SB_RANK <- 0.5   # NetMHCpan EL rank strictly below this = strong binder
MHC_AFF_NM  <- 500   # MHCflurry affinity strictly below this nM = binder

run_date    <- format(Sys.Date(), "%Y%m%d")

cat("[CONFIG] OUTPUT_DIR:    ", output_dir, "\n")
cat("[CONFIG] NMP_SB_RANK:  < ", NMP_SB_RANK, "%\n")
cat("[CONFIG] MHC_AFF_NM:   < ", MHC_AFF_NM, " nM\n")
cat("[CONFIG] Run date:      ", run_date, "\n\n")

###########################################################################
# 2. Helper: find newest file matching a pattern in output_dir
###########################################################################

newest <- function(pattern) {
  files <- list.files(output_dir, pattern = pattern, full.names = TRUE)
  if (length(files) == 0) return(NULL)
  files[which.max(file.info(files)$mtime)]
}

# Read normal MHCflurry output and the legacy Step 3a CSV whose header has
# 8 fields while each data row has 11. For that file, affinity is field 7
# and presentation score is field 10.
read_mhcflurry <- function(path) {
  probe <- readLines(path, n = 2L, warn = FALSE)
  if (length(probe) < 2L) stop("[ERROR] Empty MHCflurry file: ", path)

  header_n <- lengths(strsplit(probe[1L], ",", fixed = TRUE))
  data_n   <- lengths(strsplit(probe[2L], ",", fixed = TRUE))

  if (header_n == 8L && data_n == 11L) {
    cat("[WARN] Detected legacy 8-header/11-data CSV; parsing fields 1,2,7,10\n")
    return(fread(
      path, skip = 1L, header = FALSE,
      select = c(1L, 2L, 7L, 10L),
      col.names = c("peptide", "allele", "mhcflurry_affinity",
                    "mhcflurry_presentation_score"),
      na.strings = c("", "NA")
    ))
  }

  header <- names(fread(path, nrows = 0L))
  affinity <- intersect(
    c("mhcflurry_affinity", "mhcflurry_binding_affinity"), header
  )[1L]
  required <- c("peptide", "allele", "mhcflurry_presentation_score")
  missing <- setdiff(required, header)
  if (length(missing) || is.na(affinity)) {
    stop("[ERROR] Unsupported MHCflurry columns in ", path,
         "; header: ", paste(header, collapse = ","))
  }

  dt <- fread(
    path, select = c("peptide", "allele", affinity,
                     "mhcflurry_presentation_score"),
    na.strings = c("", "NA")
  )
  if (affinity != "mhcflurry_affinity") {
    setnames(dt, affinity, "mhcflurry_affinity")
  }
  dt
}

normalize_allele <- function(x) {
  toupper(gsub("\\*", "", trimws(x)))
}

###########################################################################
# 3. Process one length at a time to stay within memory
#
# Per length:
#   a. Load NetMHCpan TSV -> filter EL rank < NMP_SB_RANK
#   b. Load MHCflurry CSV -> filter affinity < MHC_AFF_NM
#   c. Inner join on peptide + allele (both tools must agree = Tier 1)
#   d. Load Step 1 coordinate TSV -> join on n_mer to get enst/aa_start/aa_end
#   e. Append to running results list, free memory
###########################################################################

all_sb <- vector("list", 4)
lengths <- c("08", "09", "10", "11")

for (idx in seq_along(lengths)) {
  lenpad <- lengths[idx]
  cat(sprintf("\n=== Processing %smer ===\n", lenpad))

  # --- NetMHCpan ---------------------------------------------------------
  nmp_file <- newest(sprintf("^canonical_%smer_netmhcpan_[0-9_]+\\.tsv$", lenpad))
  if (is.null(nmp_file)) {
    cat(sprintf("[WARN] No NetMHCpan file for %smer -- skipping\n", lenpad)); next
  }
  cat(sprintf("[INFO] NMP file: %s\n", basename(nmp_file)))

  nmp <- fread(nmp_file, na.strings = c("", "NA"),
               select = c("allele", "peptide",
                          "netmhcpan_EL_score", "netmhcpan_EL_rank",
                          "netmhcpan_BA_score", "netmhcpan_BA_rank"))
  nmp[, netmhcpan_EL_rank  := as.numeric(netmhcpan_EL_rank)]
  nmp[, netmhcpan_EL_score := as.numeric(netmhcpan_EL_score)]
  nmp[, allele := normalize_allele(allele)]

  # Filter to SB: EL rank < NMP_SB_RANK
  nmp_sb <- nmp[netmhcpan_EL_rank < NMP_SB_RANK]
  cat(sprintf("[INFO] NMP: %d total rows -> %d SB (EL rank < %.1f%%)\n",
              nrow(nmp), nrow(nmp_sb), NMP_SB_RANK))
  rm(nmp); gc()

  if (nrow(nmp_sb) == 0) {
    cat(sprintf("[WARN] No NetMHCpan SB for %smer -- skipping\n", lenpad)); next
  }

  # Best NMP row per allele+peptide (lowest EL rank)
  setorder(nmp_sb, allele, peptide, netmhcpan_EL_rank)
  nmp_sb <- nmp_sb[, .SD[1L], by = .(allele, peptide)]

  # --- MHCflurry ---------------------------------------------------------
  mhc_file <- newest(sprintf("^canonical_%smers_flank_mhcflurry_[0-9_]+\\.csv$", lenpad))
  if (is.null(mhc_file)) {
    cat(sprintf("[WARN] No MHCflurry file for %smer -- skipping\n", lenpad))
    rm(nmp_sb); gc(); next
  }
  cat(sprintf("[INFO] MHC file: %s\n", basename(mhc_file)))

  mhc <- read_mhcflurry(mhc_file)

  mhc[, mhcflurry_affinity           := as.numeric(mhcflurry_affinity)]
  mhc[, mhcflurry_presentation_score := as.numeric(mhcflurry_presentation_score)]
  mhc[, allele := normalize_allele(allele)]
  if (all(is.na(mhc$mhcflurry_presentation_score)) ||
      all(is.na(mhc$mhcflurry_affinity))) {
    stop("[ERROR] Parsed MHCflurry score columns contain only NA: ", mhc_file)
  }

  # Filter to binder: affinity < MHC_AFF_NM
  mhc_sb <- mhc[mhcflurry_affinity < MHC_AFF_NM]
  cat(sprintf("[INFO] MHC: %d total rows -> %d binders (affinity < %d nM)\n",
              nrow(mhc), nrow(mhc_sb), MHC_AFF_NM))
  rm(mhc); gc()

  if (nrow(mhc_sb) == 0) {
    cat(sprintf("[WARN] No MHCflurry binders for %smer -- skipping\n", lenpad))
    rm(nmp_sb); gc(); next
  }

  # Best MHC row per allele+peptide (lowest affinity = tightest binder)
  setorder(mhc_sb, allele, peptide, mhcflurry_affinity)
  mhc_sb <- mhc_sb[, .SD[1L], by = .(allele, peptide)]

  # --- Tier 1 join: both tools must agree --------------------------------
  # Inner join on allele + peptide -- only rows present in BOTH survive
  tier1 <- merge(nmp_sb, mhc_sb, by = c("allele", "peptide"))
  cat(sprintf("[INFO] Tier 1 (both SB): %d rows (%d unique peptides)\n",
              nrow(tier1), uniqueN(tier1$peptide)))
  rm(nmp_sb, mhc_sb); gc()

  if (nrow(tier1) == 0) {
    cat(sprintf("[WARN] No Tier 1 hits for %smer\n", lenpad)); next
  }

  # Combined score: mean of NMP EL score + MHCflurry presentation score (0-1 scale)
  tier1[, combined_score := rowMeans(
    cbind(netmhcpan_EL_score, mhcflurry_presentation_score),
    na.rm = TRUE
  )]

  # --- Join coordinates from Step 1 --------------------------------------
  coord_file <- newest(sprintf("^canonical_%smers_[0-9]{8}\\.tsv$", lenpad))
  if (is.null(coord_file)) {
    cat(sprintf("[WARN] No coordinate file for %smer -- bed join skipped\n", lenpad))
    tier1[, c("enst", "aa_start", "aa_end") := NA]
  } else {
    cat(sprintf("[INFO] Coord file: %s\n", basename(coord_file)))
    coords <- fread(coord_file, na.strings = c("", "NA"),
                    select = c("enst", "aa_start", "aa_end", "n_mer"))
    setnames(coords, "n_mer", "peptide")
    # Retain every distinct transcript/position occurrence of each peptide.
    coords <- unique(coords, by = c("enst", "aa_start", "aa_end", "peptide"))

    tier1 <- merge(tier1, coords, by = "peptide", all.x = TRUE,
                   allow.cartesian = TRUE)
    n_coord <- sum(!is.na(tier1$enst))
    cat(sprintf("[INFO] %d / %d Tier 1 rows joined to coordinates\n",
                n_coord, nrow(tier1)))
    rm(coords); gc()
  }

  tier1[, peptide_length := as.integer(lenpad)]
  all_sb[[idx]] <- tier1
  rm(tier1); gc()
  cat(sprintf("[INFO] %smer done.\n", lenpad))
}

###########################################################################
# 4. Combine all lengths and write outputs
###########################################################################

cat("\n=== Combining all lengths ===\n")

combined <- rbindlist(all_sb, use.names = TRUE, fill = TRUE)
cat(sprintf("[INFO] Total Tier 1 rows (all lengths): %d\n", nrow(combined)))
cat(sprintf("[INFO] Unique peptides:  %d\n", uniqueN(combined$peptide)))
cat(sprintf("[INFO] Unique alleles:   %d\n", uniqueN(combined$allele)))
cat(sprintf("[INFO] Unique proteins:  %d\n", uniqueN(combined$enst)))

if (nrow(combined) == 0) stop("[ERROR] No Tier 1 peptides found across any length.")

# Remove low-complexity peptides (any single AA > 60% of sequence)
is_low_complexity <- function(pep) {
  chars <- strsplit(as.character(pep), "")[[1]]
  max(table(chars)) / length(chars) > 0.6
}
n_before <- nrow(combined)
combined <- combined[!sapply(peptide, is_low_complexity)]
cat(sprintf("[INFO] After low-complexity filter: %d rows (removed %d)\n",
            nrow(combined), n_before - nrow(combined)))

# Sort: protein, position, best allele
setorder(combined, enst, aa_start, netmhcpan_EL_rank)

###########################################################################
# 5. Write outputs
#    BED is intentionally SOPRANO-compatible (five columns only).  The TSV
#    retains prediction metrics for auditability and downstream prioritisation.
###########################################################################

bed_cols <- c("enst", "aa_start", "aa_end", "peptide", "allele")
tsv_cols <- c(bed_cols, "netmhcpan_EL_rank", "mhcflurry_affinity",
              "combined_score", "peptide_length")

bed_file <- file.path(output_dir,
                      sprintf("canonical_immunopeptidome_SB_%s.bed", run_date))
tsv_file <- file.path(output_dir,
                      sprintf("canonical_immunopeptidome_SB_%s.tsv", run_date))

# TSV: with header and full prediction metrics, for audit/loading in R
fwrite(combined[, intersect(tsv_cols, names(combined)), with = FALSE],
       tsv_file, sep = "\t", col.names = TRUE, quote = FALSE, na = "NA")

# Convert 1-based inclusive amino-acid coordinates to BED convention:
# zero-based start and end-exclusive end. Write one row for every strong
# peptide-HLA-coordinate mapping, using SOPRANO allele formatting.
bed <- combined[, .(
  enst,
  aa_start = as.integer(aa_start) - 1L,
  aa_end   = as.integer(aa_end),
  peptide,
  allele   = gsub("[*:]", "", allele)
)]

if (anyNA(bed)) stop("[ERROR] BED contains missing values.")
if (any(bed$aa_start < 0L)) stop("[ERROR] BED contains negative starts.")
if (any((bed$aa_end - bed$aa_start) != nchar(bed$peptide))) {
  stop("[ERROR] BED interval length does not equal peptide length.")
}

bed <- unique(bed, by = c("enst", "aa_start", "aa_end", "peptide", "allele"))
setorder(bed, enst, aa_start, aa_end, peptide, allele)

expected_pairs <- unique(combined[, .(
  peptide,
  allele = gsub("[*:]", "", allele)
)])
observed_pairs <- unique(bed[, .(peptide, allele)])
if (nrow(fsetdiff(expected_pairs, observed_pairs)) > 0L) {
  stop("[ERROR] One or more strong peptide-HLA pairs are absent from BED.")
}

# BED: exactly five columns, no header, tab-delimited.
fwrite(bed, bed_file, sep = "\t", col.names = FALSE,
       quote = FALSE, na = ".")

cat(sprintf("\n[INFO] Bed written: %s\n", bed_file))
cat(sprintf("[INFO] TSV written: %s\n", tsv_file))
cat(sprintf("[INFO] BED rows: %d\n", nrow(bed)))
cat(sprintf("[INFO] BED strong peptide-HLA pairs: %d\n", nrow(observed_pairs)))

###########################################################################
# 6. Summary
###########################################################################

runtime <- proc.time() - start_time
cat("\n=== Step 4 Summary ===\n")
cat(sprintf("  Tier 1 threshold: NMP EL rank < %.1f%% AND MHCflurry < %d nM\n",
            NMP_SB_RANK, MHC_AFF_NM))
cat(sprintf("  Total Tier 1 rows:      %d\n", nrow(combined)))
cat(sprintf("  Unique peptides:        %d\n", uniqueN(combined$peptide)))
cat(sprintf("  Unique HLA alleles:     %d\n", uniqueN(combined$allele)))
cat(sprintf("  Unique source proteins: %d\n", uniqueN(combined$enst)))
cat(sprintf("  Lengths covered:        %s\n",
            paste(sort(unique(combined$peptide_length)), collapse=", ")))
cat(sprintf("  Output bed: %s\n", basename(bed_file)))
cat(sprintf("  Output tsv: %s\n", basename(tsv_file)))
cat(sprintf("\n[DONE] Step 4 complete in %.1f min\n", runtime[3] / 60))
